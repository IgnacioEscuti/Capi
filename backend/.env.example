# Connection string de Neon (Dashboard → Connect). Usá sslmode=verify-full.
DATABASE_URL=postgresql://usuario:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full
# String largo y aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Aplicación "Capi" en Mercado Pago Developers → Credenciales de producción.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Tiene que ser idéntica a la URL de redirección registrada en la aplicación de MP.
MP_REDIRECT_URI=https://capi-phi-sandy.vercel.app/api/mp/callback
# Clave para cifrar los tokens de MP (32 bytes en hex): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se cambia, los tokens guardados ya no se pueden descifrar y hay que reconectar.
MP_TOKEN_KEY=
# Clave del HMAC de los CBU de destino (32 bytes en hex, se genera igual que la anterior y tiene que ser otra).
# Si se cambia, los CBU ya guardados dejan de coincidir con los nuevos.
CBU_HASH_KEY=
# PROVISORIO-WEB (opcional): URL de la PWA, sin barra final. Permite volver a la PWA después de conectar MP.
# ej. https://capi-web.vercel.app
WEB_URL=
PORT=3000
NODE_ENV=development
